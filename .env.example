# Deployment guard for provider environments.
# Vercel Production must use production. Preview/local sandbox may use sandbox.
APP_ENVIRONMENT=sandbox

# Public canonical site URL used in Mercado Pago return/webhook URLs.
# Production must be HTTPS and should use the final canonical domain.
# A sandbox deployment must replace this with its own HTTPS sandbox host.
NEXT_PUBLIC_SITE_URL=https://www.proxybembem.com.br

# Supabase browser-safe Auth configuration.
# The publishable key is intentionally public; it grants no admin privilege by itself.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sole administrative Supabase Auth user UUID. Server-only.
ADMIN_USER_ID=

# Mercado Pago Checkout Pro server credentials.
# Use sandbox/test configuration in Sandbox and production only after validation.
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Supabase server-only Data API credentials.
# Prefer the current sb_secret_ key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Server-only Resend credentials for transactional sending and signed delivery webhooks.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Melhor Envio OAuth2 and server-only shipping configuration.
# Sandbox and Production must use separate provider applications/credentials.
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=
MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY=
MELHOR_ENVIO_USER_AGENT=ProxyBembem (contato@proxybembem.com.br)
SHIPPING_ORIGIN_CEP=86730000
SHIPPING_QUOTE_SECRET=
CRON_SECRET=

# Server-only HMAC secret used to anonymize rate-limit buckets.
RATE_LIMIT_SECRET=
# Outside Vercel, keep 0 until reverse-proxy chain verification is complete.
# On Vercel the runtime automatically trusts exactly one platform-managed hop.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
